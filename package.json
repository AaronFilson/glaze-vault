{
  "name": "glaze-vault",
  "version": "0.1.0",
  "description": "Encrypted glaze and clay recipe vault, with Glazecalc's chemistry.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Aaron Filson",
  "scripts": {
    "predev": "node scripts/check-submodules.mjs",
    "dev": "tauri dev",
    "prebuild": "node scripts/check-submodules.mjs",
    "build": "tauri build",
    "predev:ui": "node scripts/check-submodules.mjs",
    "dev:ui": "vite",
    "prebuild:ui": "node scripts/check-submodules.mjs",
    "build:ui": "npm run typecheck && vite build",
    "pretypecheck": "node scripts/check-submodules.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json && tsc -p lib/core && tsc -p lib/catalog",
    "pretest": "node scripts/check-submodules.mjs",
    "test": "vitest run",
    "pretest:submodules": "node scripts/check-submodules.mjs",
    "test:submodules": "node --test --experimental-test-coverage --test-coverage-include=\"lib/core/**\" --test-coverage-exclude=\"lib/core/test/**\" --test-coverage-exclude=\"lib/core/scripts/**\" --test-coverage-lines=99 --test-coverage-branches=98 --test-coverage-functions=99 \"lib/core/test/*.test.js\" && node --test --experimental-test-coverage --test-coverage-include=\"lib/catalog/**\" --test-coverage-exclude=\"lib/catalog/test/**\" --test-coverage-exclude=\"lib/catalog/scripts/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"lib/catalog/test/*.test.js\"",
    "e2e": "node e2e/run.ts",
    "test:core": "cargo test --workspace",
    "test:all": "npm test && npm run test:submodules && npm run typecheck && npm run test:core",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-barcode-scanner": "^2.5.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
