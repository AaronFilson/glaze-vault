{
  "name": "glaze-vault",
  "version": "0.1.0",
  "description": "Encrypted glaze and clay recipe vault, with Glazecalc's chemistry.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Aaron Filson",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:ui": "vite",
    "build:ui": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:core": "cargo test --workspace",
    "test:all": "npm test && npm run typecheck && npm run test:core",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
